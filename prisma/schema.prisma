model TrainerSalary {
  id              String        @id @default(uuid())
  trainer         Trainer       @relation(fields: [trainerId], references: [id])
  trainerId       String
  amount          Decimal       // Amount paid
  paymentType     SalaryType    // MONTHLY, ONE_TIME, CONTRACT
  periodStart     DateTime?     // For monthly/contract payments
  periodEnd       DateTime?     // For monthly/contract payments
  paymentDate     DateTime      // Date when salary was paid
  paymentMethod   PaymentMethod // Enum: CASH, UPI, BANK_TRANSFER
  status          SalaryStatus  // PAID, PENDING, FAILED
  remarks         String?       // Notes like "March Salary", "Bonus", etc.
  // Tenant scoping
  gymId           String
  gym             Gym          @relation(fields: [gymId], references: [id])
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  
  // Branch scoping (secondary)
  gymBranchId     String
  gymBranch       GymBranch @relation(fields: [gymBranchId], references: [id])
  @@index([gymId])
}





model CommunityPost {
  id          String       @id @default(uuid())
  title       String
  content     String       // Rich text or plain text
  imageUrls   String[]     // Optional images (e.g., before/after transformation, announcement banner)
  category    PostCategory

  isPinned    Boolean      @default(false) // For important or sticky posts
  visibleTo   UserGroup[]  // Enum: who should see this post (optional)

  // Tenant scoping
  gymId        String
  gym          Gym         @relation(fields: [gymId], references: [id])

  gymBranchId  String
  gymBranch    GymBranch   @relation(fields: [gymBranchId], references: [id])

  userId       String
  user         User        @relation(fields: [userId], references: [id])

  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([gymId, gymBranchId])
  @@index([userId])
}




 









model Notification {
  id           String            @id @default(uuid())
  title        String
  message      String
  type         NotificationType

  relatedId    String?           // Optional: ID of related resource (e.g., traineeId, paymentId, postId)
  relatedType  RelatedEntity?    // Optional: What type of entity this is about (e.g., TRAINEE, PAYMENT)

  isRead       Boolean           @default(false)

  // Now points to User instead of Admin
  recipientId  String?
  recipient    User?             @relation(fields: [recipientId], references: [id])

  // Optional: if sending to a role group
  targetRole   UserRole?         // Enum: USER, ADMIN, SUPERADMIN (optional)

  // Tenant scoping
  gymId        String
  gym          Gym              @relation(fields: [gymId], references: [id])

  gymBranchId  String
  gymBranch    GymBranch        @relation(fields: [gymBranchId], references: [id])

  createdAt    DateTime          @default(now())

  @@index([gymId, gymBranchId])
  @@index([recipientId])
}







model PasswordSetupToken {
  id          String   @id @default(uuid())
  token       String   @unique
  user        User     @relation(fields: [userId], references: [id])
  userId      String
  expiresAt   DateTime
  used        Boolean  @default(false)
  createdAt   DateTime @default(now()) 

      // Tenant scoping (primary)
  gymId           String
  gym             Gym      @relation(fields: [gymId], references: [id])
  
  // Branch scoping (secondary)
  gymBranchId     String
  gymBranch       GymBranch @relation(fields: [gymBranchId], references: [id])
}




enum NotificationType {
  NEW_MEMBER
  PAYMENT_RECEIVED
  COMMUNITY_POST
  MEMBERSHIP_EXPIRING
  TRAINER_ASSIGNED
  NEW_TRAINER
  TRAINEE_PROGRESS
  MEMBERSHIP_RENEWAL
  CUSTOM
}

enum RelatedEntity {
  TRAINEE
  TRAINER
  PAYMENT
  COMMUNITY_POST
  MEMBERSHIP
}


enum PostCategory {
  ANNOUNCEMENT
  TRANSFORMATION
  EVENT
  TRAINER_UPDATE
  GENERAL
  FITNESS_TIP
  CHALLENGE
  GYM_TIMING_CHANGE
}

enum UserGroup {
  ALL
  TRAINEE
  TRAINER
}


enum SalaryStatus {
  PAID
  PENDING
  FAILED
}




enum SalaryType {
  MONTHLY
  ONE_TIME
  CONTRACT
}



enum AdminRole {
  OWNER
  MANAGER
}


enum WorkType {
  FULL_TIME
  PART_TIME
  FREELANCER
  OTHER
}

enum TrainerStatus {
  ACTIVE
  INACTIVE
}




enum Gender {
  MALE
  FEMALE
  OTHER
}



enum PaymentMethod {
  CASH
  CARD
  UPI
  BANK_TRANSFER
}

enum PaymentStatus {
  SUCCESS
  PENDING
  FAILED
}



model StaffBranch {
  id        String    @id @default(uuid())
  userId    String
  branchId  String
  gymId     String
  role      UserRole

  user      User       @relation(fields: [userId], references: [id])
  branch    GymBranch  @relation(fields: [branchId], references: [id])
  gym       Gym        @relation(fields: [gymId], references: [id])

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([userId, branchId, role])
  @@index([userId])
  @@index([branchId])
  @@index([gymId])
  @@index([role])
}





model CRMLead {
  id                 String      @id @default(uuid())
  name               String
  email              String?
  contactNumber      String
  whatsappNumber     String?
  probabilityPercent        Int        
  leadSource         String      // e.g., walk-in, Instagram, referral, etc.
  status             LeadStatus  @default(NEW)
  followUpDate       DateTime?
  notes              String?
  conversionDate     DateTime?

  // ✅ Foreign key to Membership (expected plan)
  expectedMembershipId String? 
  expectedMembership   Membership? @relation(fields: [expectedMembershipId], references: [id])

  // Multitenancy
  gymId              String
  gym                Gym         @relation(fields: [gymId], references: [id])
  gymBranchId        String
  gymBranch          GymBranch  @relation(fields: [gymBranchId], references: [id])

  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@index([gymId])
  @@index([gymBranchId])
  @@index([status])
}


enum LeadStatus {
  NEW
  CONTACTED
  FOLLOW_UP
  CONVERTED
  LOST
}


model Equipment {
  id              String              @id @default(uuid())
  name            String
  serialNumber    String?             @unique
  gymId           String              // FK to Gym
  gym             Gym                 @relation(fields: [gymId], references: [id])
  gymBranchId     String              // FK to GymBranch
  gymBranch       GymBranch           @relation(fields: [gymBranchId], references: [id])
  purchaseDate    DateTime
  status          EquipmentStatus     @default(WORKING) // enum
  maintenanceSchedules MaintenanceSchedule[]
  maintenanceLogs MaintenanceLog[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([gymId])
  @@index([gymBranchId])
}

model MaintenanceSchedule {
  id              String          @id @default(uuid())
  equipmentId     String
  equipment       Equipment       @relation(fields: [equipmentId], references: [id])
  gymId           String
  gym             Gym             @relation(fields: [gymId], references: [id])

  gymBranchId     String
  gymBranch       GymBranch       @relation(fields: [gymBranchId], references: [id])

  frequency       MaintenanceFrequency // enum: DAILY, WEEKLY, MONTHLY, etc.
  nextDueDate     DateTime
  lastServicedAt  DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model MaintenanceLog {
  id              String        @id @default(uuid())
  equipmentId     String
  equipment       Equipment     @relation(fields: [equipmentId], references: [id])
  performedById   String?       // FK to User

  gymId           String
  gym             Gym             @relation(fields: [gymId], references: [id])

  gymBranchId     String
  gymBranch       GymBranch       @relation(fields: [gymBranchId], references: [id])
  performedBy     User?              @relation("UserMaintenances", fields: [performedById], references: [id])

  status          MaintenanceStatus // enum: COMPLETED, SKIPPED, NEEDS_PARTS
  comments        String?
  photoUrl        String?
  maintenanceDate DateTime
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}



enum EquipmentStatus {
  WORKING
  NEEDS_SERVICE
  OUT_OF_ORDER
}

enum MaintenanceStatus {
  COMPLETED
  SKIPPED
  NEEDS_PARTS
}

enum MaintenanceFrequency {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}





