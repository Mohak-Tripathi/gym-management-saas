// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

// output   = "../src/generated/prisma"

generator client {
  provider = "prisma-client-js"
 
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}






model Trainee {
  id               String     @id @default(uuid())
  referenceMobileNo    String?    // Emergency or referral contact
  gender           Gender
  image                String?    // Profile picture URL
  age              Int
  address          String
  status           TraineeStatus @default(ACTIVE) // NEW ENUM: ACTIVE, INACTIVE
  personalizedGoal     String[]    // e.g., "Fat Loss", "Muscle Gain", "Posture Correction"
  healthIssues         String[]   // e.g., ["Back Pain", "Knee Injury"]

  payments         Payment[]
  workoutPlans     WorkoutPlan[]

  traineeMemberships TraineeMembership[] // One-to-many
  trainerId        String?

  // Tenant scoping (primary)
  gymId           String
  gym             Gym      @relation(fields: [gymId], references: [id])
  
  // Branch scoping (secondary)
  gymBranchId     String
  gymBranch       GymBranch @relation(fields: [gymBranchId], references: [id])


  user      User    @relation("UserTrainee", fields: [userId], references: [id])
  userId    String  @unique
   trainer          Trainer?   @relation(fields: [trainerId], references: [id])
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@index([gymId])
  @@index([gymBranchId])
}

enum TraineeStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}


model Gym {
  id              String       @id @default(uuid())
  name            String
  branches        GymBranch[]
  // Tenant relations
  users           User[]
  trainers        Trainer[]
  trainees        Trainee[]
  memberships     Membership[]
  payments        Payment[]
  workoutPlans    WorkoutPlan[]
  communityPosts  CommunityPost[]
  notifications   Notification[]
  trainerSalaries TrainerSalary[]
  traineeMemberships TraineeMembership[] 
  crmLeads    CRMLead[]
  equipment           Equipment[]         // 👈 opposite side
  maintenanceSchedules MaintenanceSchedule[]
  maintenanceLogs     MaintenanceLog[]

  passwordSetupTokens PasswordSetupToken[]
  staffBranches  StaffBranch[]

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}



model GymBranch {
  id           String     @id @default(uuid())
  name         String
  address      String
  description  String?
  isMainBranch Boolean    @default(false)
  
  // Tenant relation
  gymId        String
  gym          Gym        @relation(fields: [gymId], references: [id])
  
  // Branch relations
  trainees     Trainee[]
  trainers     Trainer[]
  traineeMemberships TraineeMembership[] // Inverse relation
  users        User[]
  staffBranches  StaffBranch[]

  notifications Notification[]
  payments      Payment[]
  workoutPlans  WorkoutPlan[]
  trainerSalaries TrainerSalary[]
  communityPosts CommunityPost[]
  passwordSetupTokens PasswordSetupToken[]
  memberships Membership[] 
  crmLeads    CRMLead[]

  equipment           Equipment[]         // 👈 opposite side
  maintenanceSchedules MaintenanceSchedule[]
  maintenanceLogs     MaintenanceLog[]
  
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([gymId])
}


model User {
  id         String     @id @default(uuid())
  email      String     @unique
  password   String?
  fullName   String
  role       UserRole
  phone      String?
  
  // Tenant scoping (primary)
  gymId      String
  gym        Gym       @relation(fields: [gymId], references: [id])
  
  // Branch scoping (secondary)
  gymBranchId String?
  gymBranch   GymBranch? @relation(fields: [gymBranchId], references: [id])

  passwordSetupTokens PasswordSetupToken[]
  trainee     Trainee?  @relation("UserTrainee")
  trainer     Trainer?  @relation("UserTrainer")
  notifications  Notification[]  
  staffBranches  StaffBranch[]  // 👈 back relation

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  communityPosts    CommunityPost[]  // 👈 Relation back to CommunityPost
  performedMaintenances MaintenanceLog[] @relation("UserMaintenances") // optional custom name

  @@index([gymId])
  @@index([gymBranchId])
}



enum UserRole {
  SUPERADMIN
  ADMIN
  RECEPTIONIST
  TRAINER
  TRAINEE
}




model Trainer {
  id               String       @id @default(uuid())
  referenceMobileNo String?
  gender           Gender     @default(MALE)
  specialization   String[]
  workType         WorkType    @default(FULL_TIME)
  joiningDate      DateTime?
  lastLoggedIn     DateTime?
  status           TrainerStatus @default(ACTIVE)
  experienceYears  Int
  certifications   Certification[]
  trainees         Trainee[]
  workoutPlans     WorkoutPlan[]
  trainerSalaries  TrainerSalary[]

  // Tenant scoping (primary)
  gymId           String
  gym             Gym      @relation(fields: [gymId], references: [id])
  
  // Branch scoping (secondary)
  gymBranchId     String
  gymBranch       GymBranch @relation(fields: [gymBranchId], references: [id])

  userId          String   @unique
  user            User     @relation("UserTrainer", fields: [userId], references: [id])

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([gymId])
  @@index([gymBranchId])
}

model Certification {
  id          String   @id @default(uuid())
  title       String   // e.g., "Certified Personal Trainer"
  institute   String?   // e.g., "ACE", "NSCA"
  issueDate   DateTime
  expiryDate  DateTime?
  documentUrl String   // Link to uploaded proof/document (PDF/image)
  trainer     Trainer  @relation(fields: [trainerId], references: [id])
  trainerId   String

 
}



model Membership {
  id           String     @id @default(uuid())
  name         String
  actualPrice  Decimal      @default(0)   // Original price
  membershipDiscountedPrice Decimal @default(0)
  baseDuration Int          @default(0) // Base duration in months
  benefits     String[]   // Generic benefits

  traineeMemberships TraineeMembership[] // One-to-many
  crmLeads    CRMLead[]

  // Tenant scoping
  gymId        String
  gym          Gym        @relation(fields: [gymId], references: [id])
  // Branch scoping (secondary)
  gymBranchId     String
  gymBranch       GymBranch @relation(fields: [gymBranchId], references: [id])
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model TraineeMembership {
  id                  String    @id @default(uuid())
  trainee             Trainee   @relation(fields: [traineeId], references: [id])
  traineeId           String
  membership          Membership @relation(fields: [membershipId], references: [id])
  membershipId        String

  discountedPrice     Decimal    // What the customer actually paid
  discountPercentage  Int?
  reasonOfDiscount    String?
  //payments  Payment[]

  extraMonths         Int?       // Extra duration due to offer
  startDate           DateTime
  endDate             DateTime

  createdAt           DateTime   @default(now())
   updatedAt    DateTime   @updatedAt

    // Tenant scoping (primary)
  gymId           String
  gym             Gym      @relation(fields: [gymId], references: [id])
  
  // Branch scoping (secondary)
  gymBranchId     String
  gymBranch       GymBranch @relation(fields: [gymBranchId], references: [id])
  @@index([gymId])
}





model Payment {
  id             String     @id @default(uuid())
  trainee        Trainee    @relation(fields: [traineeId], references: [id])
  traineeId      String
  amount         Decimal
  paymentDate    DateTime
  paymentMethod  PaymentMethod
  transactionId  String?
  status         PaymentStatus
  // Tenant scoping
  gymId          String
  gym            Gym        @relation(fields: [gymId], references: [id])
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  
  // Branch scoping (secondary)
  gymBranchId     String
  gymBranch       GymBranch @relation(fields: [gymBranchId], references: [id])
  @@index([gymId])
}

model WorkoutPlan {
  id          String   @id @default(uuid())
  trainee     Trainee  @relation(fields: [traineeId], references: [id])
  traineeId   String
  trainer     Trainer?  @relation(fields: [trainerId], references: [id])
  trainerId   String?
  title       String
  description String
  date        DateTime
  exercises   String[]
  // Tenant scoping
  gymId       String
  gym         Gym      @relation(fields: [gymId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Branch scoping (secondary)
  gymBranchId     String
  gymBranch       GymBranch @relation(fields: [gymBranchId], references: [id])
  @@index([gymId])
}

