// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

// output   = "../src/generated/prisma"

generator client {
  provider = "prisma-client-js"
 
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}



enum TrainingExperience {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum ActivityLevel {
  SEDENTARY
  LIGHT_ACTIVE
  MODERATELY_ACTIVE
  VERY_ACTIVE
  ATHLETE
}


model Trainee {
  id               String     @id @default(uuid())
  referenceMobileNo    String?    // Emergency or referral contact
  gender           Gender
  status           TraineeStatus @default(ACTIVE) // NEW ENUM: ACTIVE, INACTIVE
  personalizedGoal     String[]   // e.g., "Fat Loss", "Muscle Gain", "Posture Correction"
  healthIssues         String?  
  //payments         Payment[]
  workoutPlans     WorkoutPlan[]
  height         Float?     // Optional in case not provided initially
  weight         Float?
  bmi                Float?    
  bodyFatPercentage  Float?   


    // New fields for onboarding
  targetMuscleGroups    String[]  // Array of muscle groups to focus on
  trainingExperience    TrainingExperience?
  activityLevel         ActivityLevel?
  pushupCount           Int?      // Number of pushups they can do
  motivationSource      String?   // Source of motivation
  workoutFrequency      Int?      // Times per week
  workoutDuration       Int?      // Minutes per session
  wantsNotifications    Boolean   @default(true)


  traineeMemberships TraineeMembership[] // One-to-many
  trainerId        String?

  // Tenant scoping (primary)
  gymId           String
  gym             Gym      @relation(fields: [gymId], references: [id])
  
  // Branch scoping (secondary)
  gymBranchId     String
  gymBranch       GymBranch @relation(fields: [gymBranchId], references: [id])

  user      User    @relation("UserTrainee", fields: [userId], references: [id])
  userId    String  @unique
  trainer          Trainer?   @relation(fields: [trainerId], references: [id])
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  //invoices  Invoice[]  // back relation to Invoice

  @@index([gymId])
  @@index([gymBranchId])
}

enum TraineeStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}


model Gym {
  id              String       @id @default(uuid())
  name            String    @unique
  branches        GymBranch[]
  // Tenant relations
  users           User[]
  trainers        Trainer[]
  trainees        Trainee[]
  memberships     Membership[]
  payments        Payment[]
  workoutPlans    WorkoutPlan[]
  communityPosts  CommunityPost[]
  notifications   Notification[]
  trainerSalaries TrainerSalary[]
  traineeMemberships TraineeMembership[] 
  crmLeads    CRMLead[]
  equipment           Equipment[]         // 👈 opposite side
  maintenanceSchedules MaintenanceSchedule[]
  maintenanceLogs     MaintenanceLog[]
  feedbacks     Feedback[]  
  complaints  Complaint[]  // inverse relation

  passwordSetupTokens PasswordSetupToken[]
  staffBranches  StaffBranch[]
  attendances  Attendance[]   // 👈 Add this
  smartDevices SmartDevice[]  // 👈 Also for SmartDevice relation
  invoices  Invoice[] 

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}



model GymBranch {
  id           String     @id @default(uuid())
  name         String
  address      String
  description  String?
  isMainBranch Boolean    @default(false)
  
  // Tenant relation
  gymId        String
  gym          Gym        @relation(fields: [gymId], references: [id])
  
  // Branch relations
  trainees     Trainee[]
  trainers     Trainer[]
  traineeMemberships TraineeMembership[] // Inverse relation
  users        User[]
  staffBranches  StaffBranch[]
  invoices  Invoice[]  // back relation to Invoice
  complaints  Complaint[]  // inverse relation

  notifications Notification[]
  payments      Payment[]
  workoutPlans  WorkoutPlan[]
  trainerSalaries TrainerSalary[]
  communityPosts CommunityPost[]
  passwordSetupTokens PasswordSetupToken[]
  memberships Membership[] 
  crmLeads    CRMLead[]
  equipment           Equipment[]         // 👈 opposite side
  maintenanceSchedules MaintenanceSchedule[]
  maintenanceLogs     MaintenanceLog[]
  feedbacks     Feedback[]  
  attendances  Attendance[]   // 👈 Add this
  smartDevices SmartDevice[]  // 👈 Also for SmartDevice relation
  
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([gymId])
}


model User {
  id         String     @id @default(uuid())
  password   String?
  fullName   String
  address      String?
  role       UserRole
  birthDate   DateTime?
  phone     String   @unique           // ✅ Mandatory & unique
  email     String?  @unique           // ✅ Optional but must be unique if provided
    // Image fields
  imageUrl   String?
  imageName  String?
  mimeType   String?
  complaints  Complaint[]  // inverse relation
  aadharNumber    String?    // Added: Aadhar Number
  bloodGroup      String?    // Added: Blood Group
  clientRepresentative String? 
  
  // Tenant scoping (primary)
  gymId      String
  gym        Gym       @relation(fields: [gymId], references: [id])
  
  // Branch scoping (secondary)
  gymBranchId String?
  gymBranch   GymBranch? @relation(fields: [gymBranchId], references: [id])

  passwordSetupTokens PasswordSetupToken[]
  trainee     Trainee?  @relation("UserTrainee")
  trainer     Trainer?  @relation("UserTrainer")
  notifications  Notification[]  
  staffBranches  StaffBranch[]  // 👈 back relation
  feedbacks     Feedback[]  
  attendances Attendance[]  // 👈 Add this line

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  communityPosts    CommunityPost[]  // 👈 Relation back to CommunityPost
  performedMaintenances MaintenanceLog[] @relation("UserMaintenances") // optional custom name

  @@index([gymId])
  @@index([gymBranchId])
}






enum UserRole {
  SUPERADMIN
  ADMIN
  RECEPTIONIST
  TRAINER
  TRAINEE
}




model Trainer {
  id               String       @id @default(uuid())
  referenceMobileNo String?
  gender           Gender     @default(MALE)
  specialization   String[]
  workType         WorkType    @default(FULL_TIME)
  joiningDate      DateTime?
  lastLoggedIn     DateTime?
  status           TrainerStatus @default(ACTIVE)
  experienceYears  Int
  certifications   Certification[]
  trainees         Trainee[]
  workoutPlans     WorkoutPlan[]
  trainerSalaries  TrainerSalary[]
  height         Float?     // Optional in case not provided initially
  weight         Float?
  bmi                Float?    
  bodyFatPercentage  Float?   

  // Tenant scoping (primary)
  gymId           String
  gym             Gym      @relation(fields: [gymId], references: [id])
  
  // Branch scoping (secondary)
  gymBranchId     String
  gymBranch       GymBranch @relation(fields: [gymBranchId], references: [id])

  userId          String   @unique
  user            User     @relation("UserTrainer", fields: [userId], references: [id])

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([gymId])
  @@index([gymBranchId])
}

model Certification {
  id          String   @id @default(uuid())
  title       String   // e.g., "Certified Personal Trainer"
  institute   String?   // e.g., "ACE", "NSCA"
  issueDate   DateTime
  expiryDate  DateTime?
  documentUrl String   // Link to uploaded proof/document (PDF/image)
  trainer     Trainer  @relation(fields: [trainerId], references: [id])
  trainerId   String
 
}


model Membership {
  id           String     @id @default(uuid())
  name         String
  actualPrice  Decimal      @default(0)   // Original price
  membershipDiscountedPrice Decimal @default(0)
  baseDuration Int          @default(0) // Base duration in months
  benefits     String[]   // Generic benefits

  traineeMemberships TraineeMembership[] // One-to-many
  crmLeads    CRMLead[]

  // Tenant scoping
  gymId        String
  gym          Gym        @relation(fields: [gymId], references: [id])
  // Branch scoping (secondary)
  gymBranchId     String
  gymBranch       GymBranch @relation(fields: [gymBranchId], references: [id])
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model TraineeMembership {
  id                  String    @id @default(uuid())
  trainee             Trainee   @relation(fields: [traineeId], references: [id])
  traineeId           String
  membership          Membership @relation(fields: [membershipId], references: [id])
  membershipId        String

  discountedPrice     Decimal?    // What the customer actually paid
  discountPercentage  Int?
  reasonOfDiscount    String?
  invoices  Invoice[]  // back relation to Invoice

  extraMonths         Int?       // Extra duration due to offer
  startDate           DateTime
  endDate             DateTime

  createdAt           DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

    // Tenant scoping (primary)
  gymId           String
  gym             Gym      @relation(fields: [gymId], references: [id])
  
  // Branch scoping (secondary)
  gymBranchId     String
  gymBranch       GymBranch @relation(fields: [gymBranchId], references: [id])
  @@index([gymId])
}






enum PaymentMethod {
  CASH
  CARD
  UPI
  BANK_TRANSFER
  CHEQUE
  WALLET      // e.g. Paytm Wallet, PhonePe wallet
  OTHER       // fallback for rare cases
}


enum PaymentStatus {
  PENDING     
  PARTIALLY_PAID 
  PAID        // Fully paid
  FAILED      // Payment failed
  CANCELLED   // Payment was cancelled
  REFUNDED    // Admin issued refund
}



model Payment {
  id             String     @id @default(uuid())
  paymentDate    DateTime
  paymentMethod  PaymentMode
  transactionId  String?
  invoiceId  String
  invoice    Invoice   @relation(fields: [invoiceId], references: [id])  
  // Tenant scoping
  gymId          String
  gym            Gym        @relation(fields: [gymId], references: [id])
  gymBranchId    String
  gymBranch      GymBranch  @relation(fields: [gymBranchId], references: [id])

  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([gymId])
  @@index([gymBranchId])
}

model WorkoutPlan {
  id          String   @id @default(uuid())
  trainee     Trainee  @relation(fields: [traineeId], references: [id])
  traineeId   String
  trainer     Trainer?  @relation(fields: [trainerId], references: [id])
  trainerId   String?
  title       String
  description String
  date        DateTime
  exercises   String[]
  // Tenant scoping
  gymId       String
  gym         Gym      @relation(fields: [gymId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Branch scoping (secondary)
  gymBranchId     String
  gymBranch       GymBranch @relation(fields: [gymBranchId], references: [id])
  @@index([gymId])
}




model TrainerSalary {
  id              String        @id @default(uuid())
  trainer         Trainer       @relation(fields: [trainerId], references: [id])
  trainerId       String
  amount          Decimal       // Amount paid
  paymentType     SalaryType    // MONTHLY, ONE_TIME, CONTRACT
  periodStart     DateTime?     // For monthly/contract payments
  periodEnd       DateTime?     // For monthly/contract payments
  paymentDate     DateTime      // Date when salary was paid
  paymentMethod   PaymentMethod // Enum: CASH, UPI, BANK_TRANSFER
  status          SalaryStatus  // PAID, PENDING, FAILED
  remarks         String?       // Notes like "March Salary", "Bonus", etc.
  // Tenant scoping
  gymId           String
  gym             Gym          @relation(fields: [gymId], references: [id])
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  
  // Branch scoping (secondary)
  gymBranchId     String
  gymBranch       GymBranch @relation(fields: [gymBranchId], references: [id])
  @@index([gymId])
}





model CommunityPost {
  id          String       @id @default(uuid())
  title       String?
  content     String       // Rich text or plain text
  images      CommunityPostImage[]


  category    PostCategory @default(GENERAL) // ✅ Default value set here

  isPinned    Boolean      @default(false) // For important or sticky posts


  // Tenant scoping
  gymId        String
  gym          Gym         @relation(fields: [gymId], references: [id])

  gymBranchId  String
  gymBranch    GymBranch   @relation(fields: [gymBranchId], references: [id])

  userId       String
  user         User        @relation(fields: [userId], references: [id])

  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([gymId, gymBranchId])
  @@index([userId])
}


model CommunityPostImage {
  id              String         @id @default(uuid())
  imageUrl        String
  imageName       String
  mimeType        String

  communityPostId String
  communityPost   CommunityPost @relation(fields: [communityPostId], references: [id])

  createdAt       DateTime       @default(now())
}





 









model Notification {
  id           String            @id @default(uuid())
  title        String
  message      String
  type         NotificationType

  relatedId    String?           // Optional: ID of related resource (e.g., traineeId, paymentId, postId)
  relatedType  RelatedEntity?    // Optional: What type of entity this is about (e.g., TRAINEE, PAYMENT)

  isRead       Boolean           @default(false)

  // Now points to User instead of Admin
  recipientId  String?
  recipient    User?             @relation(fields: [recipientId], references: [id])

  // Optional: if sending to a role group
  targetRole   UserRole?         // Enum: USER, ADMIN, SUPERADMIN (optional)

  // Tenant scoping
  gymId        String
  gym          Gym              @relation(fields: [gymId], references: [id])

  gymBranchId  String
  gymBranch    GymBranch        @relation(fields: [gymBranchId], references: [id])

  createdAt    DateTime          @default(now())

  @@index([gymId, gymBranchId])
  @@index([recipientId])
}







model PasswordSetupToken {
  id          String   @id @default(uuid())
  token       String   @unique
  user        User     @relation(fields: [userId], references: [id])
  userId      String
  expiresAt   DateTime
  used        Boolean  @default(false)
  createdAt   DateTime @default(now()) 

      // Tenant scoping (primary)
  gymId           String
  gym             Gym      @relation(fields: [gymId], references: [id])
  
  // Branch scoping (secondary)
  gymBranchId     String
  gymBranch       GymBranch @relation(fields: [gymBranchId], references: [id])
}




enum NotificationType {
  NEW_MEMBER
  PAYMENT_RECEIVED
  COMMUNITY_POST
  MEMBERSHIP_EXPIRING
  TRAINER_ASSIGNED
  NEW_TRAINER
  TRAINEE_PROGRESS
  MEMBERSHIP_RENEWAL
  CUSTOM
}

enum RelatedEntity {
  TRAINEE
  TRAINER
  PAYMENT
  COMMUNITY_POST
  MEMBERSHIP
}


enum PostCategory {
  ANNOUNCEMENT
  TRANSFORMATION
  EVENT
  TRAINER_UPDATE
  GENERAL
  FITNESS_TIP
  CHALLENGE
  GYM_TIMING_CHANGE
}

enum UserGroup {
  ALL
  TRAINEE
  TRAINER
}


enum SalaryStatus {
  PAID
  PENDING
  FAILED
}



enum SalaryType {
  MONTHLY
  ONE_TIME
  CONTRACT
}



enum AdminRole {
  OWNER
  MANAGER
}


enum WorkType {
  FULL_TIME
  PART_TIME
  FREELANCER
  OTHER
}

enum TrainerStatus {
  ACTIVE
  INACTIVE
}




enum Gender {
  MALE
  FEMALE
  OTHER
}








model StaffBranch {
  id        String    @id @default(uuid())
  userId    String
  branchId  String
  gymId     String
  role      UserRole

  user      User       @relation(fields: [userId], references: [id])
  branch    GymBranch  @relation(fields: [branchId], references: [id])
  gym       Gym        @relation(fields: [gymId], references: [id])

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([userId, branchId, role])
  @@index([userId])
  @@index([branchId])
  @@index([gymId])
  @@index([role])
}





model CRMLead {
  id                 String      @id @default(uuid())
  name               String
  email              String?
  contactNumber      String
  whatsappNumber     String?
  probabilityPercent        Int        
  leadSource         String      // e.g., walk-in, Instagram, referral, etc.
  status             LeadStatus  @default(NEW)
  followUpDate       DateTime?
  notes              String?
  conversionDate     DateTime?

  // ✅ Foreign key to Membership (expected plan)
  expectedMembershipId String? 
  expectedMembership   Membership? @relation(fields: [expectedMembershipId], references: [id])

  // Multitenancy
  gymId              String
  gym                Gym         @relation(fields: [gymId], references: [id])
  gymBranchId        String
  gymBranch          GymBranch  @relation(fields: [gymBranchId], references: [id])

  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@index([gymId])
  @@index([gymBranchId])
  @@index([status])
}


enum LeadStatus {
  NEW
  CONTACTED
  FOLLOW_UP
  CONVERTED
  LOST
}



model Equipment {
  id              String              @id @default(uuid())
  name            String
  imageUrl   String?
  imageName  String?
  mimeType   String?
  serialNumber    String?             @unique
  gymId           String              // FK to Gym
  gym             Gym                 @relation(fields: [gymId], references: [id])
  gymBranchId     String              // FK to GymBranch
  gymBranch       GymBranch           @relation(fields: [gymBranchId], references: [id])
  purchaseDate    DateTime
  status          EquipmentStatus     @default(WORKING) // enum
  maintenanceSchedules MaintenanceSchedule[]
  maintenanceLogs MaintenanceLog[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([gymId])
  @@index([gymBranchId])
}

model MaintenanceSchedule {
  id              String          @id @default(uuid())
  equipmentId     String
  equipment       Equipment       @relation(fields: [equipmentId], references: [id])
  gymId           String
  gym             Gym             @relation(fields: [gymId], references: [id])

  gymBranchId     String
  gymBranch       GymBranch       @relation(fields: [gymBranchId], references: [id])

  frequency       MaintenanceFrequency // enum: DAILY, WEEKLY, MONTHLY, etc.
  nextDueDate     DateTime
  lastServicedAt  DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model MaintenanceLog {
  id              String        @id @default(uuid())
  equipmentId     String
  equipment       Equipment     @relation(fields: [equipmentId], references: [id])
  performedById   String?       // FK to User

  gymId           String
  gym             Gym             @relation(fields: [gymId], references: [id])

  gymBranchId     String
  gymBranch       GymBranch       @relation(fields: [gymBranchId], references: [id])
  performedBy     User?              @relation("UserMaintenances", fields: [performedById], references: [id])

  status          MaintenanceStatus // enum: COMPLETED, SKIPPED, NEEDS_PARTS
  comments        String?
  photoUrl        String?
  maintenanceDate DateTime
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}



enum EquipmentStatus {
  WORKING
  NEEDS_SERVICE
  OUT_OF_ORDER
}

enum MaintenanceStatus {
  COMPLETED
  SKIPPED
  NEEDS_PARTS
}

enum MaintenanceFrequency {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}




model Complaint {
  id          String   @id @default(uuid())
  subject     String
  message     String

  userId      String? 
  user        User?   @relation(fields: [userId], references: [id])

  gymId       String
  gym         Gym     @relation(fields: [gymId], references: [id])

  gymBranchId String?
  gymBranch   GymBranch? @relation(fields: [gymBranchId], references: [id])

  status      ComplaintStatus @default(PENDING)
  response    String?         // Response or resolution message

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([gymId])
  @@index([gymBranchId])
  @@index([userId])
}

enum ComplaintStatus {
  PENDING
  ACKNOWLEDGED
  RESOLVED
}





model Feedback {
  id          String   @id @default(uuid())
  message     String

  userId      String
  user        User     @relation(fields: [userId], references: [id])

  gymId       String
  gym         Gym      @relation(fields: [gymId], references: [id])

  gymBranchId String?
  gymBranch   GymBranch? @relation(fields: [gymBranchId], references: [id])

  response    String?   // Optional response/acknowledgement
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([gymId])
  @@index([gymBranchId])
  @@index([userId])
}



enum InvoiceStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}


model Invoice {
  id              String        @id @default(uuid())
  membershipId    String
  membership      TraineeMembership @relation(fields: [membershipId], references: [id])
  amountPaid      Float         @default(0)  // Amount paid in this invoice
  dueAmount       Float         // Remaining amount
  taxType         String?       // Added: Tax Type
  taxAmount       Float?        // Added: Tax Amount
    // Dates
  startDate       DateTime
  endDate         DateTime
  nextPaymentDate DateTime?     // Added: For installment payments

  status          InvoiceStatus @default(PENDING)
  receiptNumber   String        @unique // e.g., INV-2025-0001
  amountInWords   String
  terms           String?
  pdfUrl          String
  currency        String        @default("INR")
  // New: Relations to payment
  payments        Payment[]
  gymBranchId     String
  gymBranch       GymBranch     @relation(fields: [gymBranchId], references: [id])
  gymId       String
  gym         Gym      @relation(fields: [gymId], references: [id])

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([membershipId])
  @@index([status])
}

enum PaymentMode {
  CASH
  CARD
  UPI
  NET_BANKING
  CHEQUE
  OTHER
}



//TODO FOR Community feed (second phase)
//Comments or likes (for engagement)?
//Scheduling (future post date)?
//Push notification toggles when a post is made?




//Attendance




model Attendance {
  id         String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id])
  gymId      String
  gym        Gym       @relation(fields: [gymId], references: [id])
  gymBranchId String
  gymBranch  GymBranch @relation(fields: [gymBranchId], references: [id])
  timestamp  DateTime  @default(now())
  method     AttendanceMethod
  deviceId   String?
  rawData    Json?
  status     AttendanceStatus @default(SUCCESS)
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([gymBranchId])
  @@index([method])
}

enum AttendanceMethod {
  BIOMETRIC
  QR_SCAN
}

enum AttendanceStatus {
  SUCCESS
  FAIL
  DENIED
}



//Optional Smart Device Table (if managing multiple devices)

model SmartDevice {
  id         String   @id @default(uuid())
  name       String
  type       DeviceType
  ipAddress  String
  gymId      String
  gym        Gym       @relation(fields: [gymId], references: [id])
  gymBranchId String
  gymBranch  GymBranch @relation(fields: [gymBranchId], references: [id])
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
}

enum DeviceType {
  BIOMETRIC
  QR_SMART_LOCK
}



