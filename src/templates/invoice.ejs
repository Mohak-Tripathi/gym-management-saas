<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8" />
    <title>Invoice - <%= receiptNumber %></title>
    <style>
      body {
        font-family: Arial, sans-serif;
        margin: 40px;
        color: #333;
      }
      h1, h2 {
        margin: 0;
      }
      .header {
        margin-bottom: 30px;
      }
      .info-section {
        margin-bottom: 20px;
      }
      .info-section strong {
        display: inline-block;
        width: 150px;
      }
      .footer {
        margin-top: 40px;
        font-size: 12px;
        color: #666;
      }
      .table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 20px;
      }
      .table th, .table td {
        border: 1px solid #aaa;
        padding: 8px;
        text-align: left;
      }
    </style>
  </head>
  <body>
    <div class="header">
      <h1><%= gymName %></h1>
      <h2>Invoice / Receipt</h2>
      <p><strong>Receipt No:</strong> <%= receiptNumber %></p>
    </div>

    <div class="info-section">
      <p><strong>Trainee:</strong> <%= name %></p>
      <p><strong>Phone:</strong> <%= phone %></p>
      <p><strong>Branch:</strong> <%= branchName %></p>
    </div>

    <table class="table">
      <tr>
        <th>Membership</th>
        <th>Start Date</th>
        <th>End Date</th>
        <th>Amount Paid</th>
        <th>Due Amount</th>
      </tr>
      <tr>
        <td><%= membershipName %></td>
        <td><%= new Date(startDate).toDateString() %></td>
        <td><%= new Date(endDate).toDateString() %></td>
        <td>₹<%= amountPaid %></td>
        <td>₹<%= dueAmount %></td>
      </tr>
    </table>

    <p><strong>Amount in Words:</strong> <%= amountInWords %></p>

    <div class="footer">
      <p><%= terms %></p>
      <p>Generated on: <%= new Date().toLocaleDateString() %></p>
    </div>
  </body>
</html>
